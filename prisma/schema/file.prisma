enum FileAccess {
  PUBLIC
  PRIVATE
}

model File {
  id String @id @default(cuid())

  name      String
  key       String     @unique
  url       String?
  type      String?
  size      BigInt?
  access    FileAccess @default(PRIVATE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
