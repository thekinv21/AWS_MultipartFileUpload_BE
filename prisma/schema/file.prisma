enum FileAccess {
  PUBLIC
  PRIVATE
}

enum FileStatus {
  PENDING
  UPLOADED
}

model File {
  id String @id @default(cuid())

  name      String
  key       String     @unique
  type      String?
  size      BigInt?
  access    FileAccess @default(PRIVATE)
  status    FileStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
