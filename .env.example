NODE_ENV=development # development | production | test
PORT=4200
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200 # comma separated

AWS_BUCKET_NAME=your-bucket-name
AWS_S3_REGION=your-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

AWS_PRESIGNED_URL_EXPIRES_IN=1200 # seconds (20 minutes), max 604800
AWS_UPLOAD_KEY_PREFIX="uploads/" # files are stored under this prefix, must end with /

AWS_FILE_MAX_SIZE_BYTES=1073741824 # 1 GiB
AWS_FILE_MAX_NAME_LENGTH=255
AWS_FILE_CHUNK_SIZE=5242880 # 5 MiB, S3 minimum
AWS_FILE_MIN_PART_NUMBER=1
AWS_FILE_MAX_PART_NUMBER=1000 # S3 maximum is 10000

DATABASE_URL="postgres://user:password@localhost:5432/dbName"